# 秘密情報と、手元だけの設定の見本. このファイルを .env に写して値を書く（.env はコミットしない）.
# 演習はローカルのモデルが基本で、キーが無くても進められる.

# ローカルの LLM（Ollama など）の URL
LOCAL_LLM_BASE_URL=http://localhost:11434

# 従量課金の API を使う「任意」の演習だけで使う. 使い終わったらキーを無効にする
# LLM_API_KEY=
# 1 回の実行で使ってよいトークン数の上限（コードの側の上限. API の管理画面でも上限を設定する）
LLM_MAX_TOKENS_PER_RUN=20000

# 12 の API（examples/ の compose.yaml が読む）. 承認の係の鍵は長いランダムな文字列にする
# AGENT_MODEL=
# APPROVER_TOKEN=
